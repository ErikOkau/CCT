# OpenAI — guild OCR + Gear Check vision (site + Discord bot)
CHATGPT_API=your_openai_api_key
# Optional: gpt-4o (default), gpt-4o-mini for cheaper gear checks
OPENAI_VISION_MODEL=gpt-4o

# Google Sheets — path to service account JSON (local) or minified JSON (Vercel/Railway)
GOOGLE_SHEETS_CREDENTIALS=google-sheets-service-account.json

# Discord bot (services/discord-ocr-bot)
DISCORD_BOT_TOKEN=
DISCORD_COMMAND_PREFIX=?
DISCORD_REMINDER_CHANNEL_ID=
REQUIRE_DRY_RUN_FIRST=1
OCR_PROVIDER=openai
